<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.mapper.MixedOperationsMapper">
    <select id="findOne" resultType="Order">
        SELECT id FROM t_order WHERE id = #{id}
    </select>
    <insert id="insertOne">
        INSERT INTO t_order (id, amount) VALUES (#{id}, #{amount})
    </insert>
    <update id="updateOne">
        UPDATE t_order SET amount = #{amount} WHERE id = #{id}
    </update>
    <delete id="deleteOne">
        DELETE FROM t_order WHERE id = #{id}
    </delete>
</mapper>
